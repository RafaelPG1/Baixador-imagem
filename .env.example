# Copie este arquivo para ".env" (na raiz do projeto) e preencha só o que for usar.
# O .env NUNCA deve ser compartilhado nem enviado ao GitHub (o .gitignore já o bloqueia).

# ---- Tradução ----
# O motor (TranslateGemma/Ollama, DeepL, Gemini ou MyMemory) é escolhido na aba "Traduções".
# Chaves só são necessárias para os motores de nuvem, que recebem apenas o texto (nunca a imagem):
DEEPL_API_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# MyMemory (grátis): um e-mail aumenta o limite diário
# MYMEMORY_EMAIL=
# Ollama em outro endereço (padrão: http://127.0.0.1:11434)
# OLLAMA_URL=http://127.0.0.1:11434

# ---- Atualização do app Android pelo próprio app ----
# github_repo=dono/repositorio
# github_token=
